{
  "manifest_version": 3,
  "name": "Wireframe X-Ray",
  "short_name": "X-Ray",
  "version": "1.0.0",
  "description": "Turn any website into a wireframe with one click and export the structure to Figma or Claude.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Wireframe X-Ray (Alt+Shift+W)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "Toggle wireframe mode"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
